{
  "name": "tint-lexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node tools/build.ts",
    "test": "node --test test/*.test.ts tools/compare-quality_test.ts web/worker.test.ts web/compact/*.test.ts",
    "size": "node tools/measure-size.ts",
    "smoke": "node tools/smoke.ts"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gpu-lexer": "^0.0.2",
    "shiki": "4.4.3"
  }
}
